# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the browser bundle.
# NEVER put a service-role key or any third-party API key in here — those live in
# Supabase Edge Function secrets (see supabase/functions/README.md).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Feature flags
VITE_ENABLE_AI=false
