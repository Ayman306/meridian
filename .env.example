# Copy to .env.local and fill in.
#
# Only NEXT_PUBLIC_-prefixed vars reach the browser bundle. Everything else is
# server-only and readable just by Route Handlers and middleware — that is where
# every third-party API key belongs (non-negotiable #2).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Feature flags
NEXT_PUBLIC_ENABLE_AI=false

# --- server only: never prefix these with NEXT_PUBLIC_ ----------------------

# Bypasses RLS. Only for Route Handlers that have already checked the caller.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that pg_cron sends as `x-cron-secret` when calling a job route.
CRON_SECRET=

# Flight data. Both optional: without them the module still works, flights are
# entered and edited by hand, and the live view shows scheduled times — which
# is level 6 on the spec's degradation ladder and a normal state, not a broken
# one.
#
# AeroDataBox via RapidAPI. Metered 600 requests a MONTH, and the app stops
# itself at 550 (HARD_CAPS in lib/flights/providers.ts) — the fifty left over
# absorb calls that reached the provider and failed before we recorded them.
#
# Near the cap the guard stops trusting our own counter and reads the real
# balance from the provider, cached six hours, so a drifting count cannot
# quietly overspend.
#
# Server-only. This must never be prefixed NEXT_PUBLIC_ — that would put it in
# the browser bundle, where anyone can read it and spend your month.
# AERODATABOX_API_KEY=
#
# OpenSky Network, OAuth2 client credentials. ~4,000 credits a DAY, and a
# ten-hour flight costs about 600 — comfortable, but still guarded.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=

# Signs the short-lived user JWTs that a personal access token is exchanged for
# (see supabase/migrations/0019 and src/app/api/mcp/token). Supabase Dashboard →
# Project Settings → API → JWT Settings → JWT Secret.
#
# This is the key that mints sessions. Anything holding it can act as any user
# in the project, so it is server-only and must never be prefixed NEXT_PUBLIC_.
# Without it the MCP token exchange returns 503 and the rest of the app is
# unaffected — connected assistants are an addition, not a dependency.
SUPABASE_JWT_SECRET=
