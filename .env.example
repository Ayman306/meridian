# Copy to .env.local and fill in.
#
# Only NEXT_PUBLIC_-prefixed vars reach the browser bundle. Everything else is
# server-only and readable just by Route Handlers and middleware — that is where
# every third-party API key belongs (non-negotiable #2).
#
# ## Connecting an AI assistant needs nothing here
#
# There was a `SUPABASE_JWT_SECRET` in this file, and it was the worst thing in
# it: the key that mints sessions, able to act as any user in the project. It
# existed because the app signed its own Supabase JWTs for the MCP server.
#
# It does not any more. Supabase Auth is the OAuth server (0032), so it issues,
# refreshes and revokes those tokens itself. Setting up an assistant is now a
# dashboard toggle and a URL — no secret, no token to copy, and nothing to add
# below.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Feature flags
NEXT_PUBLIC_ENABLE_AI=false

# --- server only: never prefix these with NEXT_PUBLIC_ ----------------------

# Bypasses RLS. Only for Route Handlers that have already checked the caller.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that pg_cron sends as `x-cron-secret` when calling a job route.
CRON_SECRET=

# Flight data. Both optional: without them the module still works, flights are
# entered and edited by hand, and the live view shows scheduled times — which
# is level 6 on the spec's degradation ladder and a normal state, not a broken
# one.
#
# AeroDataBox via RapidAPI. Metered 600 requests a MONTH, and the app stops
# itself at 550 (HARD_CAPS in lib/flights/providers.ts) — the fifty left over
# absorb calls that reached the provider and failed before we recorded them.
#
# Near the cap the guard stops trusting our own counter and reads the real
# balance from the provider, cached six hours, so a drifting count cannot
# quietly overspend.
#
# Server-only. This must never be prefixed NEXT_PUBLIC_ — that would put it in
# the browser bundle, where anyone can read it and spend your month.
# AERODATABOX_API_KEY=
#
# OpenSky Network, OAuth2 client credentials. ~4,000 credits a DAY, and a
# ten-hour flight costs about 600 — comfortable, but still guarded.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=

# --- web push ---------------------------------------------------------------
#
# Generate a pair once, and keep them: changing them invalidates every
# subscription your users have already made.
#
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# The public key is genuinely public — every browser that subscribes is handed
# it, and it is what the push service uses to verify a message really came from
# us. NEXT_PUBLIC_ is correct here and is not an exception to non-negotiable #2:
# the private key, which does the signing, stays server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Never prefix this one. Anything holding it can send notifications as you.
VAPID_PRIVATE_KEY=

# A contact the push service can reach if your sending misbehaves. Required by
# the VAPID spec; a mailto: or an https: URL.
VAPID_SUBJECT=mailto:you@example.com
